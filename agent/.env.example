# Copy to agent/.env for `npm run dev:agent`.
NETNEW_URL=http://localhost:3000
NETNEW_TOKEN=paste-the-token-from-server/data/agent-token
# NETNEW_HOSTNAME=display-name-override
# NETNEW_INTERVAL_MS=1000
# NETNEW_STATE_DIR=~/.netnew-agent

# Log files to tail (comma-separated). The systemd journal is read automatically on Linux.
# NETNEW_LOG_FILES=/var/log/nginx/error.log,/var/log/myapp/app.log

# Turn modules off: any of logs, journal, containers, services, processes.
# NETNEW_DISABLE=containers

# Containers and Kubernetes (defaults shown).
# NETNEW_DOCKER_SOCKET=/var/run/docker.sock
# NETNEW_CGROUP_ROOT=/sys/fs/cgroup
# NETNEW_K8S_NODE=<node name, defaults to the hostname>
