{
  "name": "@netnew/agent",
  "version": "1.0.0",
  "private": true,
  "description": "NetNew monitoring agent: streams system metrics to a NetNew server every second.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "netnew-agent": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file-if-exists=.env src/index.js"
  },
  "dependencies": {
    "systeminformation": "^5.27.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "mysql2": "^3.14.0",
    "pg": "^8.16.0"
  }
}
