# Copy to backend/.env and adjust. All values are optional.

# HTTP port and bind address for the web app, API and agent WebSocket.
PORT=3000
HOST=0.0.0.0

# Where the SQLite database (and the generated agent token) are stored.
DATA_DIR=./data

# Shared secret agents use to connect. If unset, one is generated on first
# start and saved to $DATA_DIR/agent-token.
# AGENT_TOKEN=change-me

# Name shown in the app until the first-run setup sets one.
# WORKSPACE_NAME=My Workspace

# Create this admin account on start when there are no users yet, instead of
# using the /setup page (useful for automated deployments).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please

# Secure session cookies: auto (when the request came over HTTPS), true or false.
# COOKIE_SECURE=auto

# Retention: per-second metrics, and log lines (by age and row count).
RETENTION_HOURS=24
# LOG_RETENTION_HOURS=72
# LOG_MAX_ROWS=2000000

# A node is marked offline (and a critical alert is raised) after this many
# seconds without data.
OFFLINE_AFTER_SEC=15

# Public URL of the app, used for links in alert notifications.
# PUBLIC_URL=https://monitor.example.com
