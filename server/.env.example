# Copy to server/.env and adjust. All values are optional.

# HTTP port and bind address for the dashboard, API and agent WebSocket.
PORT=3000
HOST=0.0.0.0

# Where the SQLite database (and the generated agent token) are stored.
DATA_DIR=./data

# Shared secret agents use to connect. If unset, one is generated on first
# start and saved to $DATA_DIR/agent-token.
# AGENT_TOKEN=change-me

# How long per-second metrics are kept.
RETENTION_HOURS=24

# A node is marked offline (and a critical alert is raised) after this many
# seconds without data.
OFFLINE_AFTER_SEC=15

# Protect the dashboard and API with HTTP basic auth. Strongly recommended
# when the server is reachable from the internet.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=change-me

# Display name of the space, shown in the sidebar.
# SPACE_NAME=My Space

# Public URL of the dashboard, used for links in alert notifications.
# PUBLIC_URL=https://monitor.example.com
