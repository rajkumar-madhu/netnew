{
  "name": "netnew",
  "version": "1.0.0",
  "private": true,
  "description": "NetNew: real-time infrastructure monitoring. Agents, backend API and web app.",
  "workspaces": [
    "backend",
    "frontend",
    "agent"
  ],
  "scripts": {
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:agent": "npm run dev -w agent",
    "test": "npm test -w backend",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test \"e2e/**/*.e2e.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  }
}
